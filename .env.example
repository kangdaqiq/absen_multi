APP_NAME="Sistem Absensi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost         

# ── Self-Hosted Mode ─────────────────────────────────────────────────────
APP_MODE=hosted
LICENSE_KEY=XXXX-XXXX-XXXX-XXXX        
LICENSE_SERVER_URL=https://absen.jagattech.my.id

# ── Database ─────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=localhost                
DB_PORT=3306
DB_DATABASE=absen_jagat
DB_USERNAME=absen_user
DB_PASSWORD=opowae          # ← wajib diisi

# ── Session & Cache ──────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── WhatsApp API (GOWA — Go WhatsApp) ────────────────────────────────────
# Otomatis terhubung ke container "whatsapp" dalam Docker network yang sama
# Jangan diubah kecuali kamu tahu apa yang dilakukan
GOWA_API_BASE_URL=http://localhost:3000    
GOWA_API_USER=admin
GOWA_API_PASS=opowae              

# ── Mail (opsional) ──────────────────────────────────────────────────────
MAIL_MAILER=log

# ── Cloudflare R2 (Auto Backup) ------------------------------------------
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=true

# ── QRIS Manual Settings ───────────────────────────────────────────────────
QRIS_MODE=manual
QRIS_BASE_STRING="00020101021126610016ID.CO.SHOPEE.WWW01189360091800235336060208235336060303UMI51440014ID.CO.QRIS.WWW0215ID10265729711860303UMI5204581753033605802ID5910Jagat Tech6015TULANGBAWANG BA61053459462070703A0163045F57"
QRIS_MERCHANT_NAME="JAGAT TECH - SOFTWARE"
# QRIS_IMAGE_URL= (Opsional, jika menggunakan link gambar QRIS statis)

# ── Penyimpanan Foto Siswa (Opsional) ─────────────────────────────────────────
# Default kosong: menggunakan storage lokal Laravel (storage/app/public/siswa)
# Jika ingin simpan di drive/folder eksternal (misal Windows atau Linux):
# SISWA_PHOTO_PATH="D:/foto_siswa"
# SISWA_PHOTO_PATH="/mnt/external_drive/foto_siswa"
SISWA_PHOTO_PATH=

# ── Storage Server (Dokumentasi Foto/Video KBM) ─────────────────────────────
STORAGE_SERVER_URL=https://storage.jagattech.my.id
STORAGE_SERVER_KEY=android-storage-secret-key
STORAGE_SERVER_KBM_FOLDER=kbm_docs



