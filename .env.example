APP_NAME="Sistem Absensi"
APP_ENV=local
APP_KEY=base64:va4o33OON+S4D1LvV/hrsuZhjFE/pxQIkWxPTFO3xCY=                       
APP_DEBUG=true
APP_URL=http://localhost         

# ── Self-Hosted Mode ─────────────────────────────────────────────────────
APP_MODE=hosted
LICENSE_KEY=XXXX-XXXX-XXXX-XXXX        
LICENSE_SERVER_URL=https://absen.jagattech.my.id

# ── Database ─────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=localhost                
DB_PORT=3306
DB_DATABASE=absen_jagat
DB_USERNAME=absen_user
DB_PASSWORD=opowae          # ← wajib diisi

# ── Session & Cache ──────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── WhatsApp API (GOWA — Go WhatsApp) ────────────────────────────────────
# Otomatis terhubung ke container "whatsapp" dalam Docker network yang sama
# Jangan diubah kecuali kamu tahu apa yang dilakukan
WA_API_BASE_URL=http://localhost:3000    
WA_API_USER=admin                      
WA_API_PASS=opowae                    

# ── Mail (opsional) ──────────────────────────────────────────────────────
MAIL_MAILER=log

# -- Cloudflare R2 (Auto Backup) ------------------------------------------
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=true
