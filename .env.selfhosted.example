APP_NAME="Sistem Absensi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost        

# ── Self-Hosted Mode ─────────────────────────────────────────────────────
APP_MODE=self_hosted
LICENSE_KEY=XXXX-XXXX-XXXX-XXXX        
LICENSE_SERVER_URL=https://absen.jagattech.my.id   

# ── Database ─────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=localhost                  
DB_PORT=3306
DB_DATABASE=absen_jagat
DB_USERNAME=absen_user
DB_PASSWORD=opowae    

# ── Session & Cache ──────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── WhatsApp API (GOWA — Go WhatsApp) ────────────────────────────────────
GOWA_API_BASE_URL=http://localhost:3000    
GOWA_API_USER=admin
GOWA_API_PASS=opowae

# ── Mail (opsional) ──────────────────────────────────────────────────────
MAIL_MAILER=log
